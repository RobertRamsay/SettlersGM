From d711f3e46d25418260b8ca4ea8df3550c6327604 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 5 Sep 2026 22:18:51 +0000
Subject: [PATCH] The desync: the draw path was healing the map, and only where
 you were looking

The log named it. serf_count 43 on both, rnd identical to the digit, tick,
buildings, flags and players all identical - and every serf field adrift. Same
serfs, same number of random draws, same decisions, different ground.

Game.get_serf_at_pos HEALS a tile that points at a serf which no longer exists,
by writing map.set_serf_index(pos, 0). That heal was added as a safety net after
the real causes were fixed in delete_serf, and it is harmless when the simulation
calls it, because both machines run the same code in the same order on the same
tick.

The viewport calls it too - twice, in the serf draw rows. The viewport only
touches tiles that are ON SCREEN. The two players are looking at different parts
of the map, so each machine healed a different set of tiles at different
moments. The map's serf index gates movement, so from then on the serfs walked
different routes: positions, states, animations and counters all part company
while the count and the RNG stay in perfect step. Exactly the signature in the
log.

Game gains peek_serf_at_pos, a read-only lookup, and the viewport's two draw
rows use it. It still returns undefined for a stale tile, so the nil guards those
rows already have are exactly as necessary as they were - the tile simply stays
stale until the simulation next looks at it, which is where healing belongs.

Worth keeping in mind for anything added later: a read that writes is fine in the
simulation and fatal anywhere the two machines differ, and the draw path is
different by definition.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DFktm5o1kLnS2Pgvyp8tD4
---
 scripts/scr_game/scr_game.gml         | 17 +++++++++++++++++
 scripts/scr_viewport/scr_viewport.gml | 14 +++++++++-----
 2 files changed, 26 insertions(+), 5 deletions(-)

diff --git a/scripts/scr_game/scr_game.gml b/scripts/scr_game/scr_game.gml
index da185e95..be107130 100644
--- a/scripts/scr_game/scr_game.gml
+++ b/scripts/scr_game/scr_game.gml
@@ -270,6 +270,23 @@ function Game() constructor {
         return flags.get(map.get_obj_index(_pos));
     };
 
+    /// Read-only lookup, for anything that is NOT the simulation.
+    ///
+    /// get_serf_at_pos below HEALS a stale tile, which means it writes to the
+    /// map - and the map's serf index gates serf movement. That is fine when the
+    /// simulation calls it, because both machines run the same code in the same
+    /// order on the same tick. It is not fine from the DRAW path: the viewport
+    /// only touches tiles that are on screen, the two players are looking at
+    /// different parts of the map, so each machine healed different tiles at
+    /// different moments and their serfs then walked different routes.
+    ///
+    /// That was the multiplayer desync whose signature was every serf field
+    /// differing while serf_count and rnd matched exactly: the same serfs, the
+    /// same decisions, different ground.
+    static peek_serf_at_pos = function(_pos) {
+        return serfs.get(map.get_serf_index(_pos));
+    };
+
     static get_serf_at_pos = function(_pos) {
         var _index = map.get_serf_index(_pos);
         var _serf = serfs.get(_index);
diff --git a/scripts/scr_viewport/scr_viewport.gml b/scripts/scr_viewport/scr_viewport.gml
index f87d9926..9b07f0aa 100644
--- a/scripts/scr_viewport/scr_viewport.gml
+++ b/scripts/scr_viewport/scr_viewport.gml
@@ -2113,10 +2113,14 @@ function Viewport(_interface, _map) : GuiObject() constructor {
         for (var _i = 0; _i < _cols; _i++) {
             /* Active serf */
             if (map.has_serf(_pos)) {
-                var _serf = interface.get_game().get_serf_at_pos(_pos);
-
-                /* get_serf_at_pos heals a tile that points at a serf which is
-                   gone, but it still hands back undefined for this frame. */
+                var _serf = interface.get_game().peek_serf_at_pos(_pos);
+
+                /* peek_serf_at_pos deliberately does NOT heal a tile that
+                   points at a serf which is gone: healing writes to the map, and
+                   doing that from the draw path is machine dependent, because
+                   only what is on screen gets drawn. See Game.peek_serf_at_pos.
+                   It still returns undefined for such a tile, so the nil check
+                   below is exactly as necessary as it always was. */
                 if (_serf != undefined &&
                    (_serf.get_state() != SerfState.mining ||
                     (_serf.get_mining_substate() != 3 &&
@@ -2159,7 +2163,7 @@ function Viewport(_interface, _map) : GuiObject() constructor {
         for (var _i = 0; _i < _cols; _i++) {
             /* Active serf */
             if (map.has_serf(_pos)) {
-                var _serf = interface.get_game().get_serf_at_pos(_pos);
+                var _serf = interface.get_game().peek_serf_at_pos(_pos);
 
                 if (_serf != undefined &&
                     _serf.get_state() == SerfState.mining &&
