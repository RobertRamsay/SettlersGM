+        { type: BuildingType.weapon_smith,  want: 1 },
+        { type: BuildingType.farm,          want: 4 },
+        { type: BuildingType.coal_mine,     want: 3 },
+        { type: BuildingType.gold_mine,     want: 1 },
+        { type: BuildingType.gold_smelter,  want: 1 },
+    ];
