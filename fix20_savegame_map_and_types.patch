+            _out_struct[$ _names[_j]] = savegame_decode_value(
+                variable_struct_get(_value, _names[_j]), undefined, _game, _depth + 1);
         }
-        return _out;
+        return _out_struct;
     }
+
     return undefined;
 }
 
