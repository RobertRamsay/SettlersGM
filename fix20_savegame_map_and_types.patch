+            if (_current_is_array && _i < array_length(_current)) {
+                _element = _current[_i];
+            }
+            _out[_i] = savegame_decode_value(_value[_i], _element, _game, _depth + 1);
         }
         return _out;
     }
+
     if (is_struct(_value)) {
