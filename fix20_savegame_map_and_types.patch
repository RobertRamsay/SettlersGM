+function savegame_decode_value(_value, _current, _game, _depth) {
     if (_depth > 32) {
         return undefined;
     }
     if (is_undefined(_value) || is_real(_value) || is_bool(_value) || is_string(_value)) {
         return _value;
     }
+
     if (is_array(_value)) {
