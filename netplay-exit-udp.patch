@@ -353,6 +358,16 @@ function game_init_init_tables() {
    takes the last few pixels, so 40 is the honest number. */
 #macro NETPLAY_COLS       40
 
+/* EXIT, hard into the bottom-right corner of the frame. It was drawn by
