-    buffer_write(_buffer, buffer_text, _text);
-    buffer_save(_buffer, PROGRESS_PATH);
-    buffer_delete(_buffer);
+    show_debug_message("progress: mission " + string(_index + 1) + " marked complete in " +
+                       game_save_id + PROGRESS_PATH);
