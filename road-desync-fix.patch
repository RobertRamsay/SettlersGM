From 2d0d6e6ecd2b26607a6c2af82999b23e850f94c0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 6 Sep 2026 06:14:16 +0000
Subject: [PATCH] The desync: dragging a road onto a flag never crossed the
 wire

Both logs at turn 209, same building, same tick:

  building 3  pos=4027 type=2 owner=0 progress=1 u=4 constructing=1
      host:  serf_requested=1  req_failed=0
      peer:  serf_requested=0  req_failed=1

and the flags underneath it:

  flag 1 (castle flag, pos 3965)  host: path_con=4 endpoint=68
                                  peer: path_con=0 endpoint=64
  flag 3 (pos 4092)               host: path_con=1 endpoint=65
                                  peer: path_con=0 endpoint=64

The host has a road between those two flags. The peer has no paths at
all. So the peer's building could not reach an inventory, its serf
request failed, and the builder it was waiting for stayed in the castle -
which is every symptom of the last several sessions, in order.

Interface.build_road() routes through the network. But a road is not
usually finished by that function: dragging onto an existing flag
completes it in build_road_segment(), which called game.build_road()
straight into the local game with no guard. That is also the ordinary way
to connect a new building to the castle, so it fired constantly, and it
fired only on the machine doing the dragging - which is exactly the owner
correlation the last two runs showed. Now routed like every other
command, queued before build_road_end() invalidates the road.

Every mutating call in the interface is now behind a net_is_running()
guard; build_road_segment was the only one that was not.

Two more, both mine:

net_receive_check read its four digest arrays inside a struct literal.
GML does not evaluate those fields in source order, and it turned out to
run them backwards: the peer's serf digests arrived holding the inventory
array and vice versa, so "inventory slots: mine=2 theirs=42" sat in the
log next to "serf slots: mine=42 theirs=2". The coarse parts were never
affected, so the desync verdict was always right, but the per-object
naming was comparing each collection with its opposite. Read into ordered
locals; side effects do not belong in a struct literal.

net_queue_command now copies the directions array. The caller's Road is
live and extend()/undo() mutate it in place, so a queued command could
have its road edited out from under it before being sent.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DFktm5o1kLnS2Pgvyp8tD4
---
 scripts/scr_interface/scr_interface.gml | 23 ++++++++++++++-
 scripts/scr_net/scr_net.gml             | 37 ++++++++++++++++++-------
 2 files changed, 49 insertions(+), 11 deletions(-)

diff --git a/scripts/scr_interface/scr_interface.gml b/scripts/scr_interface/scr_interface.gml
index 0fb3c0d0..598e5415 100644
--- a/scripts/scr_interface/scr_interface.gml
+++ b/scripts/scr_interface/scr_interface.gml
@@ -930,7 +930,28 @@ function Interface(_game = undefined) : GuiObject() constructor {
         }
 
         if (game.get_map().get_obj(_dest) == MapObject.flag) {
-            /* Existing flag at destination, try to connect. */
+            /* Existing flag at destination, try to connect.
+
+               THIS IS A COMMAND, and it was the one that got away. Dragging a
+               road onto an existing flag finishes it here rather than through
+               build_road() below, and this path went straight into the local
+               game - so the road appeared on the machine that dragged it and
+               nowhere else. It is also the ordinary way to connect a new
+               building to the castle, which is why every session desynced
+               within a few hundred turns: with no road, the peer's building
+               could not reach an inventory, its serf request failed, and the
+               serfs it was waiting for stayed in the castle.
+
+               Queue it before build_road_end(), which invalidates the road. */
+            if (net_is_running()) {
+                net_queue_command(NetCmd.build_road, building_road.get_source(),
+                                  0, building_road.get_dirs());
+                play_sound(Sfx.click);
+                build_road_end();
+                update_map_cursor_pos(_dest);
+                return 1;
+            }
+
             if (!game.build_road(building_road, player)) {
                 build_road_end();
                 return -1;
diff --git a/scripts/scr_net/scr_net.gml b/scripts/scr_net/scr_net.gml
index a4a6d67b..49ed96ea 100644
--- a/scripts/scr_net/scr_net.gml
+++ b/scripts/scr_net/scr_net.gml
@@ -474,15 +474,24 @@ function net_receive_check(_b) {
         _parts[_i] = buffer_read(_b, buffer_u32);
     }
 
-    var _snap = {
+    /* Read into locals FIRST, in order.
+       These four calls each advance the buffer, and GML does not evaluate a
+       struct literal's fields in source order - written as a literal, the peer's
+       serf digests came back holding the inventory array and vice versa, which
+       made every object look different from its opposite number. Side effects
+       do not belong inside a struct literal. */
+    var _serfs = net_read_u32_array(_b);
+    var _blds  = net_read_u32_array(_b);
+    var _flgs  = net_read_u32_array(_b);
+    var _invs  = net_read_u32_array(_b);
+
+    ds_map_set(global.net_checks, string(_turn), {
         parts:     _parts,
-        serfs:     net_read_u32_array(_b),
-        buildings: net_read_u32_array(_b),
-        flags:     net_read_u32_array(_b),
-        invs:      net_read_u32_array(_b)
-    };
-
-    ds_map_set(global.net_checks, string(_turn), _snap);
+        serfs:     _serfs,
+        buildings: _blds,
+        flags:     _flgs,
+        invs:      _invs
+    });
 }
 
 // ---------------------------------------------------------------- lockstep
@@ -518,7 +527,15 @@ function net_ticks_available() {
 /// Queue a command the local player just issued. It executes NET_TURN_DELAY
 /// turns from now, on both machines.
 function net_queue_command(_kind, _a, _b, _dirs = []) {
-    array_push(global.net_outbox, { kind: _kind, a: _a, b: _b, dirs: _dirs });
+    /* Copy the directions. The caller's Road is still live and its dirs array
+       is mutated in place by extend() and undo(); a command that holds the
+       caller's array can have the road edited out from under it between being
+       queued and being sent. */
+    var _copy = [];
+    for (var _i = 0; _i < array_length(_dirs); _i++) {
+        array_push(_copy, _dirs[_i]);
+    }
+    array_push(global.net_outbox, { kind: _kind, a: _a, b: _b, dirs: _copy });
 }
 
 /// Called immediately before each simulation tick while networked. Does the
@@ -1130,7 +1147,7 @@ function net_building_line(_game, _i) {
                 " burning=" + string(net_bit(_b.burning)) +
                 " serf_requested=" + string(net_bit(_b.serf_requested)) +
                 " req_failed=" + string(net_bit(_b.serf_request_failed)) +
-                " knights=" + string(_b.first_knight);
+                " first_knight=#" + string(_b.first_knight);
     for (var _k = 0; _k < BUILDING_MAX_STOCK; _k++) {
         var _st = _b.stock[_k];
         _line += " | stock" + string(_k) + " type=" + string(_st.type) +
