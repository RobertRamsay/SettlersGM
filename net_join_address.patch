From e4968f6fa2e05426a3d68468c6f5ce18c9ee4ee0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 5 Sep 2026 20:33:12 +0000
Subject: [PATCH] Join asks for the host's address - loopback can never reach
 another machine

The reason it would not connect: F8 joined 127.0.0.1, which is the machine doing
the joining. It works for two instances on one PC, which is how I wrote and
described the slice, and it can NEVER work between two machines however the
firewall is set. Bob was testing across two PCs, which is the sensible way to
test this, and I built the slice around an assumption I never checked against
how it would actually be used.

F8 now opens a prompt for the host machine's address, typed with GameMaker's own
keyboard_string so backspace comes free, Enter to connect and Escape to cancel.
The address is kept in settlers.ini under [net] host, so it is typed once rather
than once per run, and the prompt is pre-filled with it. Game keys are suppressed
while the prompt is open, or typing an address would also drive the game.

The three-spelling loopback fallback is now scoped to loopback, where it is the
only place it could ever have helped.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DFktm5o1kLnS2Pgvyp8tD4
---
 objects/obj_game/Create_0.gml |  6 ++++++
 objects/obj_game/Draw_0.gml   | 10 ++++++++-
 objects/obj_game/Step_0.gml   | 40 +++++++++++++++++++++++++++++------
 scripts/scr_net/scr_net.gml   | 27 ++++++++++++++++++++---
 4 files changed, 72 insertions(+), 11 deletions(-)

diff --git a/objects/obj_game/Create_0.gml b/objects/obj_game/Create_0.gml
index ed3d23ae..39e76163 100644
--- a/objects/obj_game/Create_0.gml
+++ b/objects/obj_game/Create_0.gml
@@ -23,6 +23,12 @@ net_init();     // two-player lockstep networking (idle until F7 / F8)
 // event that is walking the interface's float list.
 global.net_pending_start = undefined;
 
+// The join prompt: F8 opens it, you type the host's address, Enter connects.
+// Not a lobby - but two machines cannot find each other without somewhere to
+// put an address, and 127.0.0.1 is only ever the machine doing the typing.
+global.net_ip_prompt = false;
+global.net_ip_text = "";
+
 // Window: integer-scaled, pixel-perfect
 window_set_size(SCREEN_W * SCREEN_SCALE, SCREEN_H * SCREEN_SCALE);
 surface_resize(application_surface, SCREEN_W, SCREEN_H);
diff --git a/objects/obj_game/Draw_0.gml b/objects/obj_game/Draw_0.gml
index d8b11582..eed7d7e5 100644
--- a/objects/obj_game/Draw_0.gml
+++ b/objects/obj_game/Draw_0.gml
@@ -24,7 +24,15 @@ if (show_debug) {
 // that fails leaves the role back at off, so gating this on net_is_active()
 // hid the one message that mattered - which is how a failed connection came to
 // look like a key that did nothing.
-if (net_status_line() != "") {
+if (global.net_ip_prompt) {
+    var _prompt = "JOIN HOST AT: " + global.net_ip_text + "_" +
+                  "   (Enter to connect, Esc to cancel)";
+    draw_set_colour(c_black);
+    draw_text(5, 5, _prompt);
+    draw_set_colour(c_yellow);
+    draw_text(4, 4, _prompt);
+    draw_set_colour(c_white);
+} else if (net_status_line() != "") {
     var _msg = "NET: " + net_status_line();
     if (net_is_running() && net_ticks_available() <= 0) {
         _msg += "  [waiting for the other player]";
diff --git a/objects/obj_game/Step_0.gml b/objects/obj_game/Step_0.gml
index cbf3ffad..6d0285be 100644
--- a/objects/obj_game/Step_0.gml
+++ b/objects/obj_game/Step_0.gml
@@ -59,9 +59,14 @@ if (keyboard_check_pressed(vk_f12)) {
     }
 }
 
-// ---- F7 hosts a two-player game, F8 joins one on this machine.
-// Deliberately keys and not a lobby yet: two instances on one PC is how the
-// lockstep gets tested, and 127.0.0.1 needs no network at all to try.
+// ---- F7 hosts a two-player game, F8 asks who to join.
+// Keys rather than a lobby for now. Press either at any point - the host starts
+// mission 1 the moment somebody connects, so do it before settling into a game
+// you care about.
+//
+// The joiner types the HOST MACHINE's address. 127.0.0.1 only ever means the
+// machine doing the typing, so it works for two instances on one PC and can
+// never work between two PCs - which is what the first version got wrong.
 if (keyboard_check_pressed(vk_f7)) {
     show_debug_message("net: F7 pressed");
     if (net_host()) {
@@ -69,9 +74,30 @@ if (keyboard_check_pressed(vk_f7)) {
     }
 }
 
-if (keyboard_check_pressed(vk_f8)) {
-    show_debug_message("net: F8 pressed");
-    net_join("127.0.0.1");
+if (keyboard_check_pressed(vk_f8) && !global.net_ip_prompt && !net_is_active()) {
+    show_debug_message("net: F8 pressed - asking for the host address");
+    global.net_ip_prompt = true;
+    // keyboard_string is GameMaker's own typed-text buffer and handles
+    // backspace itself, so seeding it with the remembered address is the whole
+    // of the text editing.
+    keyboard_string = net_load_host_ip();
+    global.net_ip_text = keyboard_string;
+}
+
+if (global.net_ip_prompt) {
+    global.net_ip_text = keyboard_string;
+
+    if (keyboard_check_pressed(vk_enter)) {
+        global.net_ip_prompt = false;
+        var _ip = string_trim(global.net_ip_text);
+        if (_ip != "") {
+            net_save_host_ip(_ip);
+            net_join(_ip);
+        }
+    } else if (keyboard_check_pressed(vk_escape)) {
+        global.net_ip_prompt = false;
+        global.net_status = "";
+    }
 }
 
 // The host starts the game as soon as somebody is actually connected.
@@ -258,7 +284,7 @@ if (keyboard_check(vk_shift)) {
 if (keyboard_check(vk_alt)) {
     _modifier |= 4;
 }
-if (keyboard_check_pressed(vk_anykey)) {
+if (keyboard_check_pressed(vk_anykey) && !global.net_ip_prompt) {
     var _key = keyboard_key;
     var _chr = -1;
     if (_key >= ord("A") && _key <= ord("Z")) {
diff --git a/scripts/scr_net/scr_net.gml b/scripts/scr_net/scr_net.gml
index 1aabb954..ad4be70e 100644
--- a/scripts/scr_net/scr_net.gml
+++ b/scripts/scr_net/scr_net.gml
@@ -110,6 +110,25 @@ function net_status_line() {
     return global.net_status;
 }
 
+// ---------------------------------------------------------- host address
+
+/// The address to join, kept in the same ini as mission progress so it survives
+/// a restart. Typing an IP once per session is enough of a tax.
+#macro NET_INI_SECTION "net"
+
+function net_load_host_ip() {
+    ini_open(PROGRESS_PATH);
+    var _ip = ini_read_string(NET_INI_SECTION, "host", "192.168.1.");
+    ini_close();
+    return _ip;
+}
+
+function net_save_host_ip(_ip) {
+    ini_open(PROGRESS_PATH);
+    ini_write_string(NET_INI_SECTION, "host", _ip);
+    ini_close();
+}
+
 // ---------------------------------------------------------------- connect
 
 function net_host() {
@@ -152,9 +171,11 @@ function net_join(_ip) {
     }
 
     var _addresses = [_ip];
-    if (_ip == "127.0.0.1") {
-        array_push(_addresses, "localhost");
-        array_push(_addresses, "::1");
+    if (_ip == "127.0.0.1" || _ip == "localhost") {
+        /* Loopback only. Two instances on ONE machine reach each other this
+           way; two machines never can, whichever spelling is used, because
+           loopback is the joining machine talking to itself. */
+        _addresses = ["127.0.0.1", "localhost", "::1"];
     }
 
     /* MUST come before the socket is created - the manual is explicit that the
