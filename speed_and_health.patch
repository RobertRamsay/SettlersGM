From 984eb47b7feff665e39b27f0431336c73008176b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 5 Sep 2026 18:05:17 +0000
Subject: [PATCH] Speed steps to 1 / 10 / 35 / 80; building health to 100 / 200
 / 400 / 1000

Speed: > is normal and >> was already right after the earlier halving, so only
the top two move - 10 and 30 more than they had, 25 -> 35 and 50 -> 80. Normal
play is still untouched at DEFAULT_GAME_SPEED, which is Freeserf's value and
therefore the Amiga's pace. Game.set_speed does not clamp, so these are used
exactly as written: game_speed 2 / 20 / 70 / 160.

Building health is the change that has been sitting outstanding since the patch
was first built, rebased onto current main. Damage is untouched at 2 a bullet and
5 a grenade, so a five-shot cycle does 13 over 2.5 s - 5.2 a second per soldier:

    building    HP    1 man   3 men
    hut        100     19 s     6 s
    tower      200     38 s    13 s
    fortress   400     1:16    26 s
    castle    1000     3:12    1:04

cf_damage accumulates rather than counting down and cf_building_hp_for() is read
at comparison time, so a building part way through a siege when this lands simply
needs more hits; nothing saved has to migrate.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DFktm5o1kLnS2Pgvyp8tD4
---
 scripts/scr_cheat_cf/scr_cheat_cf.gml | 10 +++++-----
 scripts/scr_panel/scr_panel.gml       | 18 +++++++++++-------
 2 files changed, 16 insertions(+), 12 deletions(-)

diff --git a/scripts/scr_cheat_cf/scr_cheat_cf.gml b/scripts/scr_cheat_cf/scr_cheat_cf.gml
index 02d67ec6..a9cd121c 100644
--- a/scripts/scr_cheat_cf/scr_cheat_cf.gml
+++ b/scripts/scr_cheat_cf/scr_cheat_cf.gml
@@ -61,11 +61,11 @@
 #macro CF_DMG_GRENADE     5
 #macro CF_SHOT_CYCLE      5      // every 5th shot is a grenade
 
-#macro CF_HP_HUT          80
-#macro CF_HP_TOWER        140
-#macro CF_HP_FORTRESS     220
-#macro CF_HP_CASTLE       300
-#macro CF_HP_DEFAULT      80     // anything else the lads decide to shoot at
+#macro CF_HP_HUT          100
+#macro CF_HP_TOWER        200
+#macro CF_HP_FORTRESS     400
+#macro CF_HP_CASTLE       1000
+#macro CF_HP_DEFAULT      100    // anything else the lads decide to shoot at
 #macro CF_FIRE_INTERVAL   25     // ticks between shots (50 ticks = 1 second)
 #macro CF_GRENADE_FLIGHT  22     // ticks a grenade spends in the air
 
diff --git a/scripts/scr_panel/scr_panel.gml b/scripts/scr_panel/scr_panel.gml
index 4a4a66ca..afe63e75 100644
--- a/scripts/scr_panel/scr_panel.gml
+++ b/scripts/scr_panel/scr_panel.gml
@@ -19,15 +19,19 @@
 #macro PANEL_BUTTON_COUNT 6
 #macro SPEED_BUTTON 5
 
-// Multiples of DEFAULT_GAME_SPEED the button cycles through: >, >>, >>>.
+// Multiples of DEFAULT_GAME_SPEED the button cycles through: >, >>, >>>, >>>>.
 // game_speed is what Game.update adds to tick each step.
-// Halved from 20 / 50 / 100 - the old steps ran away from the eye and there was
-// nothing usable between normal pace and a blur. Normal play is deliberately
-// NOT touched: step 1 stays at DEFAULT_GAME_SPEED, which is Freeserf's own
-// value and therefore the Amiga's pace.
+//
+// Tuned by play, not by arithmetic. > is normal and >> was already right after
+// the earlier halving; the top two were the ones with nothing useful in them,
+// so they take 10 and 30 more than they had: 25 -> 35 and 50 -> 80.
+//
+// Normal play is deliberately NOT touched: step 1 stays at DEFAULT_GAME_SPEED,
+// which is Freeserf's own value and therefore the Amiga's pace. Game.set_speed
+// does not clamp, so these are used exactly as written.
 #macro SPEED_STEP_2 10
-#macro SPEED_STEP_3 25
-#macro SPEED_STEP_4 50
+#macro SPEED_STEP_3 35
+#macro SPEED_STEP_4 80
 
 
 enum PanelButton {
-- 
2.43.0

