From 5d0be4acfc22ab68d1f8d64c40110cf48ee503d5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 7 Sep 2026 19:02:21 +0000
Subject: [PATCH] The save list stops painting a black rectangle over the panel

ListSavedFiles filled its whole area with flat black before drawing the
rows, which reads as a hole cut in the panel rather than part of it - the
box already has a background and this was covering it. Gone. The selected
row still fills, because that one is doing a job.

The rows get a black shadow now they are drawn over a pattern instead of
over a flat colour: the same green-on-black pair draw_box_string uses
everywhere else on these screens. Without it the green sits on the stone
and is hard to pick out.

color_background went with it rather than being left set and unused, so
nothing reads as though the list still paints one.

The widget is shared, so this is the load screen and the in-game save
popup both.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DFktm5o1kLnS2Pgvyp8tD4
---
 scripts/scr_popup/scr_popup.gml | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/scripts/scr_popup/scr_popup.gml b/scripts/scr_popup/scr_popup.gml
index 2e9ff65c..af9d4abf 100644
--- a/scripts/scr_popup/scr_popup.gml
+++ b/scripts/scr_popup/scr_popup.gml
@@ -2261,7 +2261,8 @@ function ListSavedFiles() : GuiObject() constructor {
     commit_handler = undefined;
     folder_path = "";
     row_height = 11;
-    color_background = make_colour_rgb(0x00, 0x00, 0x00);
+    /* No color_background any more - the list does not paint one. Kept out
+       rather than left set and unused, so nothing reads as if it still does. */
     color_selected = make_colour_rgb(0x00, 0x8b, 0x47);
     editing = false;
     edit_text = "";
@@ -2381,8 +2382,14 @@ function ListSavedFiles() : GuiObject() constructor {
             update();
         }
 
-        gfx_fill_rect(0, 0, width, height, color_background);
+        /* No background. The list used to paint a flat dark rectangle over its
+           whole area, which reads as a hole cut in the panel rather than part
+           of it - the box already has a background, and this was covering it.
+           The selected row still fills, because that one has a job to do.
 
+           The rows get a black shadow now that they are drawn over the pattern
+           instead of over a flat colour. Same pair of colours draw_box_string
+           uses everywhere else on this screen. */
         var _rows = height div row_height;
         var _n = array_length(items);
 
@@ -2413,7 +2420,7 @@ function ListSavedFiles() : GuiObject() constructor {
                 _name = string_copy(_name, 1, 17);
             }
             gfx_draw_string(1, _y + 1, _number + ". " + _name,
-                            global.popup_color_green, -1);
+                            global.popup_color_green, c_black);
         }
     };
 
