@@ -291,9 +303,58 @@ function savegame_decode_game(_data) {
     savegame_apply_struct(_game.map, _data.map, _game);
     savegame_apply_struct(_game, _data.game, _game);
 
+    if (!savegame_check_map(_game)) {
