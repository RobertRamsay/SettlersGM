     }
     if (_data.version != SAVEGAME_VERSION) {
-        show_debug_message("savegame: version " + string(_data.version) +
-                           ", expected " + string(SAVEGAME_VERSION));
+        show_debug_message("savegame: this file is version " + string(_data.version) +
